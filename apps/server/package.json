{
  "name": "@homura-genuine/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "homura 中央授权服务：签发/到期/功能范围/Ed25519 签名下发 + 管理台同源托管",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
