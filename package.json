{
  "name": "homura-genuine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "homura 中央授权服务：许可证签发、到期与功能范围控制、Ed25519 签名下发（消费侧见 ../homura 的 @homurajs/license）",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keygen": "tsx scripts/keygen.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
